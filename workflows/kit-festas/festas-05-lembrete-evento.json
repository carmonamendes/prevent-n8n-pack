{
  "name": "Festas — 05 Lembrete de Evento (cron diário)",
  "nodes": [
    {
      "id": "node-cron-lembrete",
      "name": "Todo dia às 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [80, 300],
      "parameters": {
        "rule": { "interval": [ { "triggerAtHour": 8, "triggerAtMinute": 0 } ] }
      }
    },
    {
      "id": "node-ler-reservas-lembrete",
      "name": "Ler Reservas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [300, 300],
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "={{$env.SHEETS_FESTAS_ID}}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Reservas" },
        "options": {}
      }
    },
    {
      "id": "node-filtrar-amanha",
      "name": "Eventos de Amanhã",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 300],
      "parameters": {
        "jsCode": "const amanha = $now.plus({ days: 1 }).toFormat('yyyy-MM-dd');\nconst pagos = $('Ler Reservas').all().map(i => i.json)\n  .filter(r => String(r.data_evento).slice(0,10) === amanha && String(r.status||'').toUpperCase() === 'PAGO');\nif (pagos.length === 0) return [];\nconst linhas = pagos.map(r => `• ${r.kit_nome} — ${r.periodo || 'dia'} — ${r.cliente_nome} (${r.cliente_whatsapp})\\n   ${r.endereco || 'sem endereço'} — Total R$ ${r.valor_total}`).join('\\n');\nconst texto = `📅 *AGENDA DE AMANHÃ (${$now.plus({days:1}).toFormat('dd/MM/yyyy')})*\\n\\n${pagos.length} evento(s):\\n\\n${linhas}`;\nreturn [{ json: { total: pagos.length, texto } }];"
      }
    },
    {
      "id": "node-avisar-dono-lembrete",
      "name": "WhatsApp: Agenda (dono)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [740, 300],
      "parameters": {
        "method": "POST",
        "url": "={{$env.EVOLUTION_API_URL}}/message/sendText/{{$env.EVOLUTION_INSTANCE}}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "apikey", "value": "={{$env.EVOLUTION_API_KEY}}" } ] },
        "sendBody": true,
        "bodyParameters": { "parameters": [
          { "name": "number", "value": "={{$env.WA_FESTAS_DONO}}" },
          { "name": "text", "value": "={{ $json.texto }}" }
        ] }
      }
    }
  ],
  "connections": {
    "Todo dia às 8h": { "main": [[{ "node": "Ler Reservas", "type": "main", "index": 0 }]] },
    "Ler Reservas": { "main": [[{ "node": "Eventos de Amanhã", "type": "main", "index": 0 }]] },
    "Eventos de Amanhã": { "main": [[{ "node": "WhatsApp: Agenda (dono)", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "saveManualExecutions": true },
  "tags": ["festas", "agenda", "lembrete", "cron"]
}
