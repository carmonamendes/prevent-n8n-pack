{
  "name": "Festas — 03 Webhook Mercado Pago (confirmação)",
  "nodes": [
    {
      "id": "node-webhook-mp",
      "name": "Webhook Mercado Pago",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [80, 300],
      "webhookId": "festas-mp-webhook",
      "parameters": {
        "path": "festas-mp-webhook",
        "httpMethod": "POST",
        "responseMode": "onReceived",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "node-extrair-id",
      "name": "Extrair Pagamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 300],
      "parameters": {
        "jsCode": "const j = $json;\nconst body = j.body || {};\nconst query = j.query || {};\nconst tipo = String(body.type || body.topic || query.type || query.topic || '').toLowerCase();\nconst paymentId = body.data?.id || query['data.id'] || query.id || body.id || null;\nif (tipo && !tipo.includes('payment')) return [];\nif (!paymentId) return [];\nreturn [{ json: { payment_id: String(paymentId) } }];"
      }
    },
    {
      "id": "node-get-payment",
      "name": "MP: Consultar Pagamento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://api.mercadopago.com/v1/payments/{{ $json.payment_id }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "=Bearer {{$env.FESTAS_MP_ACCESS_TOKEN}}" } ] },
        "options": {}
      }
    },
    {
      "id": "node-avaliar",
      "name": "Avaliar Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 300],
      "parameters": {
        "jsCode": "const p = $json;\nconst aprovado = String(p.status || '').toLowerCase() === 'approved';\nif (!aprovado) return [];\nreturn [{ json: {\n  reserva_id: String(p.external_reference || ''),\n  payment_id: String(p.id || ''),\n  valor_pago: p.transaction_amount || 0\n} }];"
      }
    },
    {
      "id": "node-ler-reservas-mp",
      "name": "Ler Reservas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [960, 300],
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "={{$env.SHEETS_FESTAS_ID}}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Reservas" },
        "options": {}
      }
    },
    {
      "id": "node-casar-reserva",
      "name": "Casar Reserva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 300],
      "parameters": {
        "jsCode": "const alvo = $('Avaliar Status').item.json;\nconst reserva = $('Ler Reservas').all().map(i => i.json).find(r => String(r.id) === alvo.reserva_id);\nif (!reserva) return [];\nif (String(reserva.status).toUpperCase() === 'PAGO') return []; // idempotência\nreturn [{ json: { ...reserva, payment_id: alvo.payment_id } }];"
      }
    },
    {
      "id": "node-marcar-pago",
      "name": "Marcar como PAGO",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1400, 300],
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "mode": "id", "value": "={{$env.SHEETS_FESTAS_ID}}" },
        "sheetName": { "__rl": true, "mode": "name", "value": "Reservas" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["id"],
          "value": {
            "id": "={{ $json.id }}",
            "status": "PAGO",
            "pagamento_id": "={{ $json.payment_id }}"
          }
        }
      }
    },
    {
      "id": "node-avisar-cliente-mp",
      "name": "WhatsApp: Cliente (pago)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1620, 200],
      "parameters": {
        "method": "POST",
        "url": "={{$env.EVOLUTION_API_URL}}/message/sendText/{{$env.EVOLUTION_INSTANCE}}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "apikey", "value": "={{$env.EVOLUTION_API_KEY}}" } ] },
        "sendBody": true,
        "bodyParameters": { "parameters": [
          { "name": "number", "value": "={{ $('Casar Reserva').item.json.cliente_whatsapp }}" },
          { "name": "text", "value": "=✅ *Pagamento confirmado!*\n\nOlá {{ $('Casar Reserva').item.json.cliente_nome }}, sua reserva do *{{ $('Casar Reserva').item.json.kit_nome }}* para *{{ $('Casar Reserva').item.json.data_evento }}* está confirmada.\n\nReserva: {{ $('Casar Reserva').item.json.id }}\nTotal pago: R$ {{ $('Casar Reserva').item.json.valor_total }}\n\nObrigado por reservar com a {{ $env.FESTAS_NOME_NEGOCIO }}! 🎉" }
        ] }
      }
    },
    {
      "id": "node-avisar-dono-mp",
      "name": "WhatsApp: Dono (pago)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1620, 400],
      "parameters": {
        "method": "POST",
        "url": "={{$env.EVOLUTION_API_URL}}/message/sendText/{{$env.EVOLUTION_INSTANCE}}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "apikey", "value": "={{$env.EVOLUTION_API_KEY}}" } ] },
        "sendBody": true,
        "bodyParameters": { "parameters": [
          { "name": "number", "value": "={{$env.WA_FESTAS_DONO}}" },
          { "name": "text", "value": "=💰 *RESERVA PAGA (Mercado Pago)*\n\n*Reserva:* {{ $('Casar Reserva').item.json.id }}\n*Kit:* {{ $('Casar Reserva').item.json.kit_nome }}\n*Data:* {{ $('Casar Reserva').item.json.data_evento }}\n*Cliente:* {{ $('Casar Reserva').item.json.cliente_nome }} — {{ $('Casar Reserva').item.json.cliente_whatsapp }}\n*Total:* R$ {{ $('Casar Reserva').item.json.valor_total }}\n\nData bloqueada na agenda. ✅" }
        ] }
      }
    }
  ],
  "connections": {
    "Webhook Mercado Pago": { "main": [[{ "node": "Extrair Pagamento", "type": "main", "index": 0 }]] },
    "Extrair Pagamento": { "main": [[{ "node": "MP: Consultar Pagamento", "type": "main", "index": 0 }]] },
    "MP: Consultar Pagamento": { "main": [[{ "node": "Avaliar Status", "type": "main", "index": 0 }]] },
    "Avaliar Status": { "main": [[{ "node": "Ler Reservas", "type": "main", "index": 0 }]] },
    "Ler Reservas": { "main": [[{ "node": "Casar Reserva", "type": "main", "index": 0 }]] },
    "Casar Reserva": { "main": [[{ "node": "Marcar como PAGO", "type": "main", "index": 0 }]] },
    "Marcar como PAGO": { "main": [[
      { "node": "WhatsApp: Cliente (pago)", "type": "main", "index": 0 },
      { "node": "WhatsApp: Dono (pago)", "type": "main", "index": 0 }
    ]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "saveManualExecutions": true },
  "tags": ["festas", "pagamento", "mercadopago", "webhook"]
}
