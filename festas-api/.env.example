# ─── Servidor ─────────────────────────────────────────────────
PORT=3333
NODE_ENV=production
# Origem(ns) permitida(s) no CORS. Separe por vírgula. Use * só em dev.
CORS_ORIGIN=https://atelieabelhinha.com.br
# URL pública desta API (usada no notification_url do Mercado Pago)
PUBLIC_API_URL=https://api.atelieabelhinha.com.br

# ─── Banco de dados (MariaDB) ─────────────────────────────────
# Formato Prisma. Em docker-compose o host é "db".
DATABASE_URL="mysql://festas:festas_pwd@db:3306/festas"
# Usadas só pelo docker-compose para criar o banco:
MARIADB_ROOT_PASSWORD=troque_root
MARIADB_DATABASE=festas
MARIADB_USER=festas
MARIADB_PASSWORD=festas_pwd

# ─── Autenticação ─────────────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=12h
# Admin criado no primeiro seed:
ADMIN_EMAIL=admin@atelieabelhinha.com.br
ADMIN_SENHA=troque-a-senha
ADMIN_NOME=Administrador

# ─── Negócio (valores iniciais; editáveis no painel admin) ────
NOME_NEGOCIO=Ateliê Abelhinha
TAXA_MONTAGEM=120.00
TAXA_ENTREGA_BASE=30.00
TAXA_ENTREGA_KM=3.50
ANTECEDENCIA_MIN_DIAS=2

# ─── Pix (chave estática p/ Copia-e-Cola BR Code) ─────────────
PIX_CHAVE=seu-email-ou-chave@exemplo.com
PIX_NOME=NOME DO RECEBEDOR
PIX_CIDADE=SAO PAULO

# ─── Mercado Pago ─────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_URL_SUCESSO=https://atelieabelhinha.com.br/#/retorno/sucesso
MP_URL_PENDENTE=https://atelieabelhinha.com.br/#/retorno/pendente
MP_URL_ERRO=https://atelieabelhinha.com.br/#/retorno/erro

# ─── WhatsApp (Evolution API) — opcional ──────────────────────
# Deixe EVOLUTION_API_URL vazio para desligar as notificações.
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=festas
EVOLUTION_API_KEY=
WA_DONO=5511977776666
