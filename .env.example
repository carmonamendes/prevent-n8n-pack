# ─── Prevent API ──────────────────────────────────────────────
PREVENT_API_URL=http://SEU_SERVIDOR:3000
PREVENT_API_TOKEN=seu_token_aqui

# ─── Evolution API (WhatsApp) ─────────────────────────────────
EVOLUTION_API_URL=http://SEU_SERVIDOR_EVOLUTION:8080
EVOLUTION_INSTANCE=prevent-instance
EVOLUTION_API_KEY=sua_chave_evolution

# ─── Grupos e Números WhatsApp ────────────────────────────────
# Formato Evolution API: 5511999998888 (sem + e sem @)
WA_GRUPO_EMERGENCIA=5511999990001-group@g.us
WA_GRUPO_OPERACIONAL=5511999990002-group@g.us
WA_GRUPO_SUPERVISORES=5511999990003-group@g.us
WA_PORTARIA_GRUPO=5511999990004-group@g.us
WA_SUPERVISOR_RONDAS=5511988887777
WA_SUPERVISOR_PLANTAO=5511988886666
WA_OPERADOR_PLANTAO=5511988885555
WA_DIRETORIA=5511988884444

# ─── Google Sheets (IDs das planilhas) ────────────────────────
# Pegar o ID da URL: docs.google.com/spreadsheets/d/<<ESTE_ID>>/edit
SHEETS_LOG_ALARMES_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_exemplo
SHEETS_LOG_RONDAS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_exemplo2
SHEETS_LOG_ACESSOS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_exemplo3
SHEETS_HISTORICO_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_exemplo4

# ══════════════════════════════════════════════════════════════
#  MÓDULO FESTAS — Locação de Kits de Festa + Arcos de Balão
#  (workflows em workflows/kit-festas/ — ver docs/kit-festas.md)
# ══════════════════════════════════════════════════════════════

# ─── Google Sheets do módulo Festas ───────────────────────────
# Planilha única com 3 abas: "Kits", "Reservas", "Bloqueios"
SHEETS_FESTAS_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_festas

# ─── Contato do negócio (dono/operador) ───────────────────────
WA_FESTAS_DONO=5511977776666
FESTAS_NOME_NEGOCIO=Kit Festas & Arcos

# ─── Taxas padrão (em reais, ponto decimal) ───────────────────
FESTAS_TAXA_MONTAGEM=120.00
# Entrega: taxa base + valor por km (o frontend envia a distância estimada)
FESTAS_TAXA_ENTREGA_BASE=30.00
FESTAS_TAXA_ENTREGA_KM=3.50
# Antecedência mínima para reservar (em dias)
FESTAS_ANTECEDENCIA_MIN_DIAS=2

# ─── Pix (chave estática para gerar Copia-e-Cola) ─────────────
# Tipo de chave: cpf | cnpj | email | telefone | aleatoria
FESTAS_PIX_CHAVE=seu-email-ou-chave@exemplo.com
FESTAS_PIX_NOME=NOME DO RECEBEDOR
FESTAS_PIX_CIDADE=SAO PAULO

# ─── URL pública do n8n (para callbacks do Mercado Pago) ──────
FESTAS_N8N_BASE_URL=https://SEU_N8N

# ─── Mercado Pago ─────────────────────────────────────────────
# Access Token de produção (Bearer). NUNCA versionar o valor real.
FESTAS_MP_ACCESS_TOKEN=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# URLs de retorno após pagamento (páginas do frontend)
FESTAS_MP_URL_SUCESSO=https://deliveryland.com.br/festas/obrigado.html
FESTAS_MP_URL_PENDENTE=https://deliveryland.com.br/festas/pendente.html
FESTAS_MP_URL_ERRO=https://deliveryland.com.br/festas/erro.html

# ─── Segurança ────────────────────────────────────────────────
# Token simples exigido nos endpoints administrativos (painel admin)
FESTAS_ADMIN_TOKEN=troque-por-um-token-forte
# Origem permitida no CORS das respostas dos webhooks
FESTAS_CORS_ORIGIN=https://deliveryland.com.br
